#!/bin/sh
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
PROJECT_ROOT=$(CDPATH= cd -- "$ROOT/.." && pwd -P); export PROJECT_ROOT
. "$ROOT/lib/common.sh"
. "$ROOT/lib/state.sh"
. "$ROOT/lib/tree.sh"
. "$ROOT/lib/naming.sh"

usage() { echo "usage: action <action> ..." >&2; exit 2; }
context_window() { tas_validate_id "$1" pane || return 2; tas_tmux display-message -p -t "$1" '#{window_id}'; }
context_session() {
  tas_validate_id "$1" pane || return 2
  window=$(context_window "$1") || return 2
  tas_tmux list-windows -a -F '#{session_id}	#{session_name}	#{window_id}' |
    awk -F '\t' -v w="$window" '$3==w && $2 !~ /^__awesome_sidebar_/{print $1; exit}'
}
context_content_pane() { window=$(context_window "$1") || return 2; tas_tmux list-panes -t "$window" -F '#{pane_id} #{@awesome_sidebar_kind}' | awk '$2!="sidebar"{print $1;exit}'; }
context_group() {
  session=$1; window=$2; pane=$3
  tas_validate_id "$session" session && tas_validate_id "$window" window && tas_validate_id "$pane" pane || return 2
  [ "$(context_window "$pane")" = "$window" ] || return 1
  group=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_group)
  [ -n "$group" ] || return 1
  tas_validate_text "$group" || return 2
  printf '%s\n' "$group"
}
group_storage() {
  group=$1; context=${2-}
  if [ -n "$context" ]; then
    window=$(context_window "$context") || return 2
    storage=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_storage)
    [ -n "$storage" ] && { printf '%s\n' "$storage"; return 0; }
  fi
  tas_tmux list-sessions -F '#{session_name} #{@awesome_sidebar_group} #{@awesome_sidebar_storage}' | awk -v g="$group" '$2==g && $3!=""{print $1; exit}'
}
group_host() {
  group=$1; context=${2-}
  if [ -n "$context" ]; then
    window=$(context_window "$context") || return 2
    actual=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_group)
    [ "$actual" = "$group" ] || return 1
    host=$(context_session "$context")
    [ -n "$host" ] || host="\$${group#s}"
    case "$host" in *-w*) host=${host%%-w*};; esac
    printf '%s\n' "$host"
    return 0
  fi
  host=$(tas_tmux list-sessions -F '#{session_id} #{session_name} #{@awesome_sidebar_group}' | awk -v g="$group" '$3==g && $2 !~ /^__awesome_sidebar_/{print $1; exit}')
  [ -n "$host" ] || case "$group" in
    s[0-9]*-w[0-9]*) host="\$${group#s}"; host=${host%%-w*} ;;
  esac
  printf '%s\n' "$host"
}
window_has_link() { tas_tmux list-windows -t "$1" -F '#{window_id}' | awk -v w="$2" '$0==w{ok=1} END{exit !ok}'; }

enable_group() {
  session=$1; window=$2; pane=$3
  tas_validate_id "$session" session && tas_validate_id "$window" window && tas_validate_id "$pane" pane || return 2
  kind=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_kind}')
  [ "$kind" = sidebar ] && return 0
  group="session-${session#\$}"
  tas_validate_text "$group" || return 2
  width=$(tas_clamp_width "$(tas_tmux show-option -gqv @awesome_sidebar_width)")
  icons=$(tas_tmux show-option -gqv @awesome_sidebar_icons); [ "$icons" = nerd ] || icons=ascii
  tas_tmux set-option -t "$session" @awesome_sidebar_enabled on || return 1
  tas_tmux set-option -t "$session" @awesome_sidebar_group "$group" || return 1
  tas_tmux set-option -t "$session" @awesome_sidebar_host_session "$session" || return 1
  tas_tmux set-option -w -t "$window" @awesome_sidebar_group "$group" || return 1
  tas_tmux set-option -w -t "$window" @awesome_sidebar_kind content || return 1
  tab=$(printf '\t')
  window_index=$(tas_tmux list-windows -t "$session" -F "#{window_id}${tab}#{window_index}" | awk -F '\t' -v w="$window" '$1==w{print $2;exit}')
  tas_tmux set-option -w -t "$window" @awesome_sidebar_host_index "$window_index" || return 1
  content_path=$(tas_tmux display-message -p -t "$pane" '#{pane_current_path}')
  smart_name=$(tas_smart_window_name "$content_path" "$window_index")
  tas_tmux rename-window -t "$window" "$smart_name" || return 1
  managed_path=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_worktree_path)
  legacy_name=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_name)
  if [ -z "$managed_path" ] && [ -n "$legacy_name" ] && [ "$legacy_name" = "$(basename "$content_path")" ]; then
    managed_path=$(git -C "$content_path" rev-parse --show-toplevel 2>/dev/null || :)
    [ -z "$managed_path" ] || tas_tmux set-option -w -t "$window" @awesome_sidebar_worktree_path "$managed_path" || return 1
  fi
  sidebar=$(tas_tmux list-panes -t "$window" -F "#{pane_id}${tab}#{@awesome_sidebar_kind}" |
    awk -F '\t' '$2=="sidebar"{print $1;exit}')
  saved_cursor=''
  saved_collapsed=''
  saved_query=''
  if [ -n "$sidebar" ] && [ "$(tas_tmux display-message -p -t "$sidebar" '#{pane_left}')" != 0 ]; then
    saved_cursor=$(tas_tmux show-option -p -qv -t "$sidebar" @awesome_sidebar_cursor)
    saved_collapsed=$(tas_tmux show-option -p -qv -t "$sidebar" @awesome_sidebar_collapsed)
    saved_query=$(tas_tmux show-option -p -qv -t "$sidebar" @awesome_sidebar_query)
    tas_tmux kill-pane -t "$sidebar" || return 1
    sidebar=''
  fi
  if [ -z "$sidebar" ]; then
    leftmost=$(tas_tmux list-panes -t "$window" -F "#{pane_id}${tab}#{pane_left}" |
      awk -F '\t' 'NR==1{id=$1;left=$2} $2<left{id=$1;left=$2} END{print id}')
    [ -n "$leftmost" ] || return 1
    sidebar=$(tas_tmux split-window -d -h -b -p "$width" -t "$leftmost" -P -F '#{pane_id}') || return 1
    tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_kind sidebar || return 1
    tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_group "$group" || return 1
    tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_host_session "$session" || return 1
    tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_cursor "$saved_cursor" || return 1
    tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_collapsed "$saved_collapsed" || return 1
    tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_query "$saved_query" || return 1
  fi
  tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_kind sidebar || return 1
  tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_group "$group" || return 1
  tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_host_session "$session" || return 1
  tas_tmux resize-pane -t "$sidebar" -x "${width}%" || return 1
  current_cursor=$(tas_tmux show-option -p -qv -t "$sidebar" @awesome_sidebar_cursor)
  cursor_path=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_worktree_path)
  [ -n "$cursor_path" ] || cursor_path=$(git -C "$content_path" rev-parse --show-toplevel 2>/dev/null || :)
  if [ -n "$cursor_path" ]; then
    cursor_path=$(CDPATH= cd -- "$cursor_path" 2>/dev/null && pwd -P || printf '%s' "$cursor_path")
    tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_cursor "worktree:$cursor_path" || return 1
  else
    case "$current_cursor" in
      worktree:*) ;;
      @*) window_has_link "$session" "$current_cursor" || tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_cursor "$window" || return 1 ;;
      *) tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_cursor "$window" || return 1 ;;
    esac
  fi
  tas_tmux respawn-pane -k -t "$sidebar" "$ROOT/sidebar-view" "$session" "$sidebar" "$width" "$icons" || return 1
  tas_signal_group "$group"
}

focus_sidebar() {
  window=$1
  tas_validate_id "$window" window || return 2
  tab=$(printf '\t')
  sidebar=$(tas_tmux list-panes -t "$window" -F "#{pane_id}${tab}#{@awesome_sidebar_kind}" |
    awk -F '\t' '$2=="sidebar"{print $1;exit}')
  [ -n "$sidebar" ] || return 1
  tas_tmux select-pane -t "$sidebar"
}

sync_active_window() {
  window=$1
  tas_validate_id "$window" window || return 2
  tab=$(printf '\t')
  sidebar=$(tas_tmux list-panes -t "$window" -F "#{pane_id}${tab}#{@awesome_sidebar_kind}" 2>/dev/null |
    awk -F '\t' '$2=="sidebar"{print $1;exit}')
  [ -n "$sidebar" ] || return 0
  active_path=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_worktree_path)
  if [ -z "$active_path" ]; then
    details=$(tas_window_content_details "$window")
    IFS='|' read -r content_path command dead <<EOF
$details
EOF
    active_path=$(git -C "$content_path" rev-parse --show-toplevel 2>/dev/null || :)
  fi
  if [ -n "$active_path" ]; then
    active_path=$(CDPATH= cd -- "$active_path" 2>/dev/null && pwd -P || printf '%s' "$active_path")
    row_id=worktree:$active_path
    active_label=$(tas_sidebar_project_label "$active_path" || :)
  else
    row_id=$window
    active_label=''
  fi
  tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_cursor "$row_id" || return 1
  tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_active_label "$active_label" || return 1
  tas_tmux send-keys -t "$sidebar" C-a
}

select_existing_window() {
  window=$1
  tas_validate_id "$window" window || return 2
  tab=$(printf '\t')
  target=$(tas_tmux list-panes -t "$window" -F "#{pane_id}${tab}#{@awesome_sidebar_kind}" 2>/dev/null |
    awk -F '\t' '$2!="sidebar"{print $1;exit}')
  [ -n "$target" ] || return 1
  tas_tmux select-window -t "$window" \; select-pane -t "$target"
}

session_new() {
  group=$1; path=$2; name=$3; context=${4-}
  tas_validate_text "$group" && tas_validate_text "$path" && tas_validate_text "$name" || return 2
  if [ -n "$context" ]; then
    session=$(context_session "$context")
  else
    session=$(tas_tmux list-sessions -F '#{session_id} #{session_name}' | awk '$2 !~ /^__awesome_sidebar_/{print $1;exit}')
  fi
  tas_validate_id "$session" session || return 1
  [ -d "$path" ] || return 1
  win=$(tas_tmux new-window -d -t "$session" -n "$name" -c "$path" -P -F '#{window_id}') || return 1
  window_index=$(tas_tmux display-message -p -t "$win" '#{window_index}')
  smart_name=$(tas_smart_window_name "$path" "$window_index")
  tas_tmux rename-window -t "$win" "$smart_name" || return 1
  tas_tmux set-option -w -t "$win" @awesome_sidebar_group "$group" || return 1
  tas_tmux set-option -w -t "$win" @awesome_sidebar_kind content || return 1
  tas_tmux set-option -w -t "$win" @awesome_sidebar_name "$smart_name" || return 1
  tas_tmux set-option -w -t "$win" @awesome_sidebar_worktree_path "$path" || return 1
  tas_signal_group "$group"
  printf '%s\n' "$win"
}

activate_row() {
  pane=$1; row_kind=$2; target=$3; path=${4-}; window_hint=${5-}
  tas_validate_id "$pane" pane || return 2
  case "$row_kind" in
    session)
      tas_validate_id "$target" window || return 2
      tas_touch_recent session "$target" || :
      recent_group=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_group}')
      [ -z "$recent_group" ] || tas_signal_group "$recent_group" || :
      select_existing_window "$target" && return 0
      ;;
    worktree)
      tas_validate_text "$target" && tas_validate_text "$path" && [ -n "$path" ] || return 2
      tas_touch_recent worktree "$target" "$path" || :
      recent_group=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_group}')
      [ -z "$recent_group" ] || tas_signal_group "$recent_group" || :
      if [ -n "$window_hint" ]; then
        tas_validate_id "$window_hint" window || return 2
        tas_touch_recent session "$window_hint" || :
        select_existing_window "$window_hint" && return 0
      fi
      ;;
    *) return 2 ;;
  esac
  group=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_group}')
  [ -n "$group" ] && tas_validate_text "$group" || return 1
  session=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_host_session)
  [ -n "$session" ] || session=$(context_session "$pane")
  tas_validate_id "$session" session || return 1
  case "$row_kind" in
    session)
      session_select "$group" "$target" "$pane" "$session"
      ;;
    worktree)
      "$ROOT/discover-worktrees" --activate "$group" "$path" "$pane" "$session"
      ;;
    *) return 2 ;;
  esac
}

session_select() {
  group=$1; win=$2; context=${3-}; host_session=${4-}
  tas_validate_id "$win" window || return 2
  if [ -n "$host_session" ]; then
    tas_validate_id "$host_session" session || return 2
    host=$host_session
  else
    host=$(group_host "$group" "$context")
  fi
  [ -n "$host" ] || return 1
  window_has_link "$host" "$win" || return 1
  tab=$(printf '\t')
  host_index=$(tas_tmux list-windows -t "$host" -F "#{window_id}${tab}#{window_index}" |
    awk -F '\t' -v w="$win" '$1==w{print $2;exit}')
  [ -n "$host_index" ] || return 1
  tas_tmux select-window -t "$host:$host_index" || return 1
  sidebar=$(tas_tmux list-panes -t "$win" -F "#{pane_id}${tab}#{@awesome_sidebar_kind}" |
    awk -F '\t' '$2=="sidebar"{print $1;exit}')
  if [ -z "$sidebar" ]; then
    content=$(tas_tmux list-panes -t "$win" -F "#{pane_id}${tab}#{@awesome_sidebar_kind}" |
      awk -F '\t' '$2!="sidebar"{print $1;exit}')
    [ -n "$content" ] && enable_group "$host" "$win" "$content"
    sidebar=$(tas_tmux list-panes -t "$win" -F "#{pane_id}${tab}#{@awesome_sidebar_kind}" |
      awk -F '\t' '$2=="sidebar"{print $1;exit}')
  fi
  content=$(tas_tmux list-panes -t "$win" -F "#{pane_id}${tab}#{@awesome_sidebar_kind}" |
    awk -F '\t' '$2!="sidebar"{print $1;exit}')
  [ -z "$content" ] || tas_tmux select-pane -t "$content"
}

repo_common_dir() {
  path=$1
  repo=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || :)
  [ -n "$repo" ] || return 1
  common=$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null || :)
  case "$common" in /*) ;; *) common=$repo/$common ;; esac
  CDPATH= cd -- "$common" 2>/dev/null && pwd -P
}

worktree_add() {
  pane=$1; path=$2; requested=${3-}; start_point=${4-}
  tas_validate_id "$pane" pane && tas_validate_text "$path" && tas_validate_text "$requested" && tas_validate_text "$start_point" || return 2
  repo=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || :)
  [ -n "$repo" ] || { tas_tmux display-message 'Not a Git project'; return 1; }
  repo=$(CDPATH= cd -- "$repo" && pwd -P) || return 1
  base=$(dirname "$repo")/.worktrees/$(basename "$repo")
  name=$requested
  if [ -z "$name" ]; then
    number=1
    while git -C "$repo" show-ref --verify --quiet "refs/heads/worktree-$number" || [ -e "$base/worktree-$number" ]; do number=$((number + 1)); done
    name=worktree-$number
  fi
  git check-ref-format --branch "$name" >/dev/null 2>&1 || { tas_tmux display-message "Invalid worktree name: $name"; return 1; }
  slug=$(printf '%s' "$name" | awk '{gsub(/[^[:alnum:]_.-]+/,"-");print}')
  destination=$base/$slug
  [ ! -e "$destination" ] || { tas_tmux display-message "Worktree path already exists: $destination"; return 1; }
  mkdir -p "$base" || return 1
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$name"; then
    result=$(git -C "$repo" worktree add "$destination" "$name" 2>&1) || { tas_tmux display-message "$(tas_sanitize_display "$result")"; return 1; }
  else
    if [ -n "$start_point" ]; then
      git -C "$repo" rev-parse --verify --quiet "$start_point^{commit}" >/dev/null || { tas_tmux display-message "Unknown base ref: $start_point"; return 1; }
      result=$(git -C "$repo" worktree add -b "$name" "$destination" "$start_point" 2>&1) || { tas_tmux display-message "$(tas_sanitize_display "$result")"; return 1; }
    else
      result=$(git -C "$repo" worktree add -b "$name" "$destination" 2>&1) || { tas_tmux display-message "$(tas_sanitize_display "$result")"; return 1; }
    fi
  fi
  group=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_group}')
  [ -z "$group" ] || tas_signal_group "$group"
  tas_tmux display-message "Added worktree: $name"
  CDPATH= cd -- "$destination" 2>/dev/null && pwd -P
}

rename_row() {
  pane=$1; kind=$2; target=$3; path=$4; label=${5-}
  tas_validate_id "$pane" pane && tas_validate_text "$path" && tas_validate_text "$label" || return 2
  case "$kind" in
    session)
      tas_validate_id "$target" window || return 2
      if [ -n "$label" ]; then tas_tmux set-option -w -t "$target" @awesome_sidebar_label "$label"
      else tas_tmux set-option -wu -t "$target" @awesome_sidebar_label 2>/dev/null || :; fi
      ;;
    worktree) tas_path_option_set alias "$path" "$label" ;;
    *) return 2 ;;
  esac
  group=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_group}')
  [ -z "$group" ] || tas_signal_group "$group"
}

row_command() {
  pane=$1; kind=$2; target=$3; path=$4; verb=$5; hint=${6-}
  tas_validate_id "$pane" pane && tas_validate_text "$path" || return 2
  case "$verb" in
    shell) activate_row "$pane" "$kind" "$target" "$path" "$hint" ;;
    editor|lazygit)
      session=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_host_session)
      [ -n "$session" ] || session=$(context_session "$pane")
      tas_validate_id "$session" session && [ -d "$path" ] || return 1
      if [ "$verb" = editor ]; then
        command_name=$(tas_tmux show-option -gqv @awesome_sidebar_editor); [ -n "$command_name" ] || command_name=${EDITOR:-nvim}
      else
        command_name=$(tas_tmux show-option -gqv @awesome_sidebar_git_ui); [ -n "$command_name" ] || command_name=lazygit
      fi
      tas_validate_text "$command_name" || return 2
      win=$(tas_tmux new-window -t "$session" -c "$path" -P -F '#{window_id}' "$command_name") || return 1
      tas_tmux set-option -w -t "$win" @awesome_sidebar_worktree_path "$path" || :
      tas_touch_recent session "$win" || :
      group=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_group}')
      [ -z "$group" ] || tas_signal_group "$group"
      ;;
    copy) tas_tmux set-buffer -- "$path"; tas_tmux display-message "Copied: $(tas_sanitize_display "$path")" ;;
    reveal)
      if command -v open >/dev/null 2>&1; then open "$path" >/dev/null 2>&1 &
      elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$path" >/dev/null 2>&1 &
      else tas_tmux display-message 'No file manager opener found'; return 1; fi
      ;;
    prune)
      result=$(git -C "$path" worktree prune -v 2>&1) || { tas_tmux display-message "$(tas_sanitize_display "$result")"; return 1; }
      tas_tmux display-message "${result:-No stale worktrees}"
      group=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_group}')
      [ -z "$group" ] || tas_signal_group "$group"
      ;;
    *) return 2 ;;
  esac
}

windows_for_path() {
  session=$1; selected_path=$2; scope=$3
  selected_root=$(git -C "$selected_path" rev-parse --show-toplevel 2>/dev/null || :)
  [ -z "$selected_root" ] || selected_root=$(CDPATH= cd -- "$selected_root" 2>/dev/null && pwd -P || :)
  selected_common=''
  [ -z "$selected_root" ] || selected_common=$(repo_common_dir "$selected_root" || :)
  selected_plain=$(CDPATH= cd -- "$selected_path" 2>/dev/null && pwd -P || printf '%s' "$selected_path")
  for candidate in $(tas_tmux list-windows -t "$session" -F '#{window_id}'); do
    details=$(tas_window_content_details "$candidate")
    IFS='|' read -r candidate_path command dead <<EOF
$details
EOF
    candidate_root=$(git -C "$candidate_path" rev-parse --show-toplevel 2>/dev/null || :)
    [ -z "$candidate_root" ] || candidate_root=$(CDPATH= cd -- "$candidate_root" 2>/dev/null && pwd -P || :)
    if [ "$scope" = worktree ]; then
      [ -n "$selected_root" ] && [ "$candidate_root" = "$selected_root" ] && printf '%s\n' "$candidate"
    elif [ -n "$selected_common" ]; then
      candidate_common=''; [ -z "$candidate_root" ] || candidate_common=$(repo_common_dir "$candidate_root" || :)
      [ "$candidate_common" = "$selected_common" ] && printf '%s\n' "$candidate"
    else
      candidate_plain=$(CDPATH= cd -- "$candidate_path" 2>/dev/null && pwd -P || printf '%s' "$candidate_path")
      [ "$candidate_plain" = "$selected_plain" ] && printf '%s\n' "$candidate"
    fi
  done
}

close_windows() {
  session=$1; context_pane=$2; targets=$3
  [ -n "$targets" ] || return 0
  total=$(tas_tmux list-windows -t "$session" -F '#{window_id}' | awk 'END{print NR}')
  removing=$(printf '%s\n' "$targets" | awk 'NF{n++}END{print n+0}')
  if [ "$removing" -ge "$total" ]; then
    tas_tmux new-window -d -t "$session" -n shell -c "${HOME:-/}" >/dev/null || return 1
  fi
  current=$(context_window "$context_pane" 2>/dev/null || :)
  for target in $targets; do [ "$target" = "$current" ] || tas_tmux kill-window -t "$target" 2>/dev/null || :; done
  if printf '%s\n' "$targets" | awk -v w="$current" '$0==w{found=1}END{exit !found}'; then
    tas_tmux kill-window -t "$current" 2>/dev/null || :
  fi
}

remove_row() {
  pane=$1; row_kind=$2; path=$3
  tas_validate_id "$pane" pane && tas_validate_text "$path" || return 2
  session=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_host_session)
  [ -n "$session" ] || session=$(context_session "$pane")
  tas_validate_id "$session" session || return 1
  case "$row_kind" in
    worktree)
      root=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || :)
      [ -n "$root" ] || return 1
      root=$(CDPATH= cd -- "$root" && pwd -P) || return 1
      targets=$(windows_for_path "$session" "$root" worktree)
      result=$(git -C "$root" worktree remove "$root" 2>&1) || { tas_tmux display-message "$(tas_sanitize_display "$result")"; return 1; }
      close_windows "$session" "$pane" "$targets"
      ;;
    session)
      targets=$(windows_for_path "$session" "$path" folder)
      close_windows "$session" "$pane" "$targets"
      ;;
    *) return 2 ;;
  esac
}

disable_group() {
  session=$1; window=$2; pane=$3; group=$4
  tas_validate_id "$session" session && tas_validate_id "$window" window && tas_validate_id "$pane" pane || return 2
  storage=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_storage)
  [ -n "$storage" ] || return 1
  for win in $(tas_tmux list-windows -t "$storage" -F '#{window_id}'); do
    window_has_link "$session" "$win" || tas_tmux link-window -s "$win" -t "$session:" || return 1
  done
  for sidebar in $(tas_tmux list-panes -t "$window" -F '#{pane_id}'); do
    [ "$(tas_tmux display-message -p -t "$sidebar" '#{@awesome_sidebar_kind}')" = sidebar ] && tas_tmux kill-pane -t "$sidebar" || :
  done
  tas_tmux set-option -w -t "$window" @awesome_sidebar_enabled off || return 1
  tas_tmux kill-session -t "$storage" 2>/dev/null || :
}

disable_session() {
  session=$1; group=$2
  tas_validate_id "$session" session || return 2
  storage=$(tas_tmux show-option -qv -t "$session" @awesome_sidebar_storage)
  [ -n "$storage" ] || return 1
  for window in $(tas_tmux list-windows -t "$storage" -F '#{window_id}'); do
    window_has_link "$session" "$window" || tas_tmux link-window -s "$window" -t "$session:" || return 1
  done
  for window in $(tas_tmux list-windows -t "$session" -F '#{window_id}'); do
    for sidebar in $(tas_tmux list-panes -t "$window" -F '#{pane_id}'); do
      [ "$(tas_tmux display-message -p -t "$sidebar" '#{@awesome_sidebar_kind}')" = sidebar ] && tas_tmux kill-pane -t "$sidebar" || :
    done
  done
  tas_tmux set-option -t "$session" @awesome_sidebar_enabled off || return 1
  tas_tmux kill-session -t "$storage" 2>/dev/null || :
}

auto_enable_window() {
  session=$1; window=$2; pane=${3-}
  tas_validate_id "$session" session && tas_validate_id "$window" window || return 2
  attempt=0
  while ! tas_validate_id "$pane" pane 2>/dev/null && [ "$attempt" -lt 5 ]; do
    pane=$(tas_tmux list-panes -t "$window" -F '#{pane_id} #{@awesome_sidebar_kind}' 2>/dev/null |
      awk '$2!="sidebar"{print $1;exit}' || :)
    tas_validate_id "$pane" pane 2>/dev/null && break
    attempt=$((attempt + 1))
    sleep 0.05
  done
  tas_validate_id "$pane" pane 2>/dev/null || return 0
  name=$(tas_tmux display-message -p -t "$session" '#{session_name}')
  case "$name" in __awesome_sidebar_*) return 0;; esac
  group=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_group)
  [ -n "$group" ] || group="s${session#\$}-w$(tas_tmux display-message -p -t "$window" '#{window_index}')"
  tas_tmux set-option -w -t "$window" @awesome_sidebar_group "$group" || return 1
  tas_with_group_lock "$group" enable_group "$session" "$window" "$pane"
}

migrate_storage_sessions() {
  tas_tmux list-sessions -F '#{session_id} #{session_name} #{@awesome_sidebar_group}' |
    while IFS=' ' read -r storage_id storage_name old_group; do
      case "$storage_name" in __awesome_sidebar_*) ;; *) continue;; esac
      case "$old_group" in
        s[0-9]*-w[0-9]*) host="\$${old_group#s}"; host=${host%%-w*} ;;
        *) continue ;;
      esac
      tas_tmux has-session -t "$host" 2>/dev/null || continue
      for win in $(tas_tmux list-windows -t "$storage_id" -F '#{window_id}'); do
        window_has_link "$host" "$win" || tas_tmux link-window -s "$win" -t "$host:" || return 1
      done
      tas_tmux kill-session -t "$storage_id" 2>/dev/null || :
    done
}

auto_enable() {
  migrate_storage_sessions || return 1
  for session in $(tas_tmux list-sessions -F '#{session_id}'); do
    name=$(tas_tmux display-message -p -t "$session" '#{session_name}')
    case "$name" in __awesome_sidebar_*) continue;; esac
    for window in $(tas_tmux list-windows -t "$session" -F '#{window_id}'); do
      pane=$(tas_tmux list-panes -t "$window" -F '#{pane_id} #{@awesome_sidebar_kind}' |
        awk '$2!="sidebar"{print $1;exit}')
      [ -n "$pane" ] || continue
      auto_enable_window "$session" "$window" "$pane" || return 1
    done
  done
}

navigate_action() {
  pane=$1; direction=$2
  tas_validate_id "$pane" pane || return 2
  group=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_group}')
  [ -n "$group" ] || return 1
  session=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_host_session)
  [ -n "$session" ] || session=$(context_session "$pane")
  tas_validate_id "$session" session || return 1
  case "$direction" in
    up|down|home|end|gg|G)
      cursor=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_cursor)
      next=$(tas_build_rows "$session" | tas_tree_visible "$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_collapsed)" | tas_cursor_move "$cursor" "$direction")
      [ -n "$next" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$next" || : ;;
    parent|child)
      cursor=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_cursor)
      [ -n "$cursor" ] || return 0
      if [ "$direction" = parent ]; then
        next=$(tas_build_rows "$session" | tas_parent_for_row "$cursor")
        [ -n "$next" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$next" || :
      else
        next=$(tas_build_rows "$session" | awk -F '\t' -v p="$cursor" '$3==p{print $2;exit}')
        [ -n "$next" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$next" || :
      fi ;;
    collapse|expand|h|l)
      case "$direction" in
        h) direction='collapse' ;;
        l) direction='expand' ;;
      esac
      cursor=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_cursor)
      row=$(tas_build_rows "$session" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}')
      [ -n "$row" ] || return 0
      kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
      collapsed=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_collapsed)
      has=$(printf '%s\n' "$collapsed" | awk -F ',' -v id="$cursor" '{for(i=1;i<=NF;i++)if($i==id)ok=1}END{print ok+0}')
      if [ "$direction" = collapse ]; then
        if [ "$kind" = session ] && [ "$has" -eq 0 ]; then
          collapsed=$(printf '%s' "$collapsed" | awk -v id="$cursor" 'BEGIN{if(length(id))print id}')
          tas_tmux set-option -p -t "$pane" @awesome_sidebar_collapsed "$collapsed"
        elif [ "$kind" != session ]; then
          next=$(tas_build_rows "$session" | tas_parent_for_row "$cursor")
          [ -n "$next" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$next" || :
        fi
      elif [ "$kind" = session ] && [ "$has" -eq 1 ]; then
        collapsed=$(printf '%s\n' "$collapsed" | awk -F ',' -v id="$cursor" '{out="";for(i=1;i<=NF;i++)if($i!=""&&$i!=id)out=out (out?",":"") $i}END{print out}')
        tas_tmux set-option -p -t "$pane" @awesome_sidebar_collapsed "$collapsed"
      elif [ "$kind" = session ]; then
        next=$(tas_build_rows "$session" | awk -F '\t' -v p="$cursor" '$3==p{print $2;exit}')
        [ -n "$next" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$next" || :
      fi ;;
    enter)
      cursor=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_cursor)
      row=$(tas_build_rows "$session" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}')
      [ -n "$row" ] || return 0
      kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
      if [ "$kind" = pane ]; then
        parent=$(printf '%s\n' "$row" | awk -F '\t' '{print $3}')
        tas_tmux select-window -t "$session:$parent" || return 1
        tas_tmux select-pane -t "$cursor"
      elif [ "$kind" = session ]; then
        session_select "$group" "$cursor" "$pane" "$session"
      elif [ "$kind" = worktree ]; then
        path=$(printf '%s\n' "$row" | awk -F '\t' '{print $7}')
        [ -n "$path" ] || return 1
        "$ROOT/discover-worktrees" --activate "$group" "$path" "$pane" "$session" || :
      fi ;;
    *) return 2;;
  esac
  tas_signal_group "$group"
}

action=${1-}; [ -n "$action" ] || usage
case $action in
  auto-enable) [ "$#" -eq 1 ] || usage; auto_enable;;
  auto-enable-window) [ "$#" -eq 3 ] || usage; auto_enable_window "$2" "$3";;
  focus)
    [ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
    window=$2; client=${3-}
    tas_validate_id "$window" window || exit 2
    [ -z "$client" ] || tas_validate_text "$client" || exit 2
    if ! focus_sidebar "$window"; then
      tab=$(printf '\t')
      session=$(tas_tmux list-windows -a -F "#{session_id}${tab}#{session_name}${tab}#{window_id}" |
        awk -F '\t' -v w="$window" '$3==w && $2 !~ /^__awesome_sidebar_/{print $1;exit}')
      [ -n "$session" ] || exit 1
      pane=$(tas_tmux list-panes -t "$window" -F "#{pane_id}${tab}#{@awesome_sidebar_kind}" |
        awk -F '\t' '$2!="sidebar"{print $1;exit}')
      [ -n "$pane" ] || exit 1
      group=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_group)
      [ -n "$group" ] || group="s${session#\$}-w${window#@}"
      tas_with_group_lock "$group" enable_group "$session" "$window" "$pane" || exit $?
      focus_sidebar "$window" || exit $?
    fi
    [ -z "$client" ] || tas_tmux switch-client -c "$client" -T awesome-sidebar
    ;;
  enter)
    [ "$#" -ge 4 ] && [ "$#" -le 5 ] || usage
    session=$2; window=$3; pane=$4; client=${5-}
    tas_validate_id "$session" session && tas_validate_id "$window" window && tas_validate_id "$pane" pane || exit 2
    [ -z "$client" ] || tas_validate_text "$client" || exit 2
    tas_tmux has-session -t "$session" 2>/dev/null || exit 0
    group=$(tas_tmux show-option -qv -t "$session" @awesome_sidebar_group)
    [ -n "$group" ] || group="s${session#\$}-w${window#@}"
    tas_with_group_lock "$group" enable_group "$session" "$window" "$pane" || exit $?
    focus_sidebar "$window" || exit $?
    [ -z "$client" ] || tas_tmux switch-client -c "$client" -T awesome-sidebar
    ;;
  enable) [ "$#" -eq 4 ] || usage; shift; tas_with_group_lock "$1" enable_group "$@";;
  disable)
    if [ "$#" -eq 2 ]; then
      session=$2; tas_validate_id "$session" session || exit 2
      window=$(tas_tmux list-windows -t "$session" -F '#{window_id}' | sed -n '1p')
      pane=$(tas_tmux list-panes -t "$window" -F '#{pane_id}' | sed -n '1p')
      group=$(tas_tmux show-option -qv -t "$session" @awesome_sidebar_group)
      tas_with_group_lock "$group" disable_session "$session" "$group"
      exit $?
    elif [ "$#" -eq 4 ]; then
      session=$2; window=$3; pane=$4
      group=$(context_group "$session" "$window" "$pane") || exit $?
      session=$(group_host "$group" "$pane") || exit $?
    else
      usage
    fi
    tas_with_group_lock "$group" disable_group "$session" "$window" "$pane" "$group" || :
    ;;
  session-new) [ "$#" -ge 4 ] && [ "$#" -le 5 ] || usage; shift; tas_with_group_lock "$1" session_new "$@";;
  session-select) [ "$#" -ge 3 ] && [ "$#" -le 5 ] || usage; shift; session_select "$@";;
  session-delete) [ "$#" -eq 4 ] || usage; [ "$4" = confirmed-yes ] || exit 2; tas_validate_id "$3" window || exit 2; tas_tmux kill-window -t "$3";;
  split) [ "$#" -ge 3 ] && [ "$#" -le 5 ] || usage; case $3 in horizontal) flag=h;; vertical) flag=v;; *) exit 2;; esac; context=${5-}; host=$(group_host "$2" "$context"); [ -n "$host" ] || exit 1; target=$(context_content_pane "$context" 2>/dev/null || tas_tmux display-message -p -t "$host" '#{window_id}'); [ "$#" -eq 3 ] && tas_tmux split-window -"$flag" -t "$target" || { [ "$#" -ge 4 ] || exit 2; case $4 in *[!0-9]*|'') exit 2;; esac; [ "$4" -ge 1 ] && [ "$4" -le 99 ] || exit 2; tas_tmux split-window -"$flag" -p "$4" -t "$target"; };;
  pane-select) [ "$#" -eq 3 ] || usage; tas_validate_id "$3" pane || exit 2; tas_tmux select-pane -t "$3";;
  refresh)
    if [ "$#" -eq 2 ]; then
      tas_signal_group "$2"
    elif [ "$#" -eq 4 ]; then
      group=$(context_group "$2" "$3" "$4") || exit $?
      tas_signal_group "$group"
    else
      usage
    fi
    ;;
  refresh-from-hook) group=$(tas_tmux display-message -p '#{@awesome_sidebar_group}'); [ -n "$group" ] && tas_signal_group "$group" || :;;
  sync-active) [ "$#" -eq 2 ] || usage; sync_active_window "$2";;
  activate-row) [ "$#" -ge 5 ] && [ "$#" -le 6 ] || usage; activate_row "$2" "$3" "$4" "$5" "${6-}";;
  worktree-add) [ "$#" -ge 4 ] && [ "$#" -le 5 ] || usage; worktree_add "$2" "$3" "$4" "${5-}";;
  remove-row) [ "$#" -eq 4 ] || usage; remove_row "$2" "$3" "$4";;
  rename-row) [ "$#" -eq 6 ] || usage; rename_row "$2" "$3" "$4" "$5" "$6";;
  row-command) [ "$#" -ge 6 ] && [ "$#" -le 7 ] || usage; row_command "$2" "$3" "$4" "$5" "$6" "${7-}";;
  navigate) [ "$#" -eq 3 ] || usage; navigate_action "$2" "$3";;
  rename) [ "$#" -eq 3 ] || usage; tas_validate_id "$2" pane || exit 2; tas_set_manual_name "$2" "$3";;
  rename-clear) [ "$#" -eq 2 ] || usage; tas_validate_id "$2" pane || exit 2; tas_clear_manual_name "$2";;
  search-update)
    if [ "$#" -eq 3 ]; then
      group=$2
      context=$3
      tas_validate_id "$context" pane || exit 2
      query=$(tas_tmux show-option -p -qv -t "$context" @awesome_sidebar_pending_query)
      tas_validate_text "$query" || exit 2
      tas_tmux set-option -pu -t "$context" @awesome_sidebar_pending_query || exit 1
    elif [ "$#" -ge 4 ] && [ "$#" -le 5 ]; then
      group=$2
      query=$3
      context=${4-}
      tas_validate_text "$query" || exit 2
    else
      usage
    fi
    host=$(group_host "$group" "$context"); [ -n "$host" ] || exit 1
    if [ -n "$context" ]; then
      pane=$context
      old=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_query)
      [ -n "$old" ] || { tas_tmux set-option -p -t "$pane" @awesome_sidebar_pre_search_cursor "$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_cursor)"; tas_tmux set-option -p -t "$pane" @awesome_sidebar_pre_search_collapsed "$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_collapsed)"; }
      tas_tmux set-option -p -t "$pane" @awesome_sidebar_query "$query"
    else
      tas_tmux set-option -t "$host" @awesome_sidebar_query "$query"
    fi
    tas_signal_group "$group";;
  search-clear) [ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage; context=${3-}; host=$(group_host "$2" "$context"); [ -n "$host" ] || exit 1; if [ -n "$context" ]; then pane=$context; tas_tmux set-option -p -t "$pane" @awesome_sidebar_query ''; saved=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_pre_search_cursor); [ -n "$saved" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$saved"; saved=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_pre_search_collapsed); tas_tmux set-option -p -t "$pane" @awesome_sidebar_collapsed "$saved"; tas_tmux set-option -pu -t "$pane" @awesome_sidebar_pre_search_cursor; tas_tmux set-option -pu -t "$pane" @awesome_sidebar_pre_search_collapsed; else tas_tmux set-option -t "$host" @awesome_sidebar_query ''; fi; tas_signal_group "$2";;
  search-activate) [ "$#" -ge 3 ] && [ "$#" -le 4 ] || usage; group=$2; target=$3; context=${4-}; tas_validate_text "$target" || exit 2; if tas_validate_id "$target" pane 2>/dev/null; then tas_tmux select-pane -t "$target"; elif tas_validate_id "$target" window 2>/dev/null; then session_select "$group" "$target" "$context"; elif [ "${target#worktree:}" != "$target" ]; then "$ROOT/discover-worktrees" --activate "$group" "${target#worktree:}"; else exit 2; fi;;
  *) usage;;
esac
