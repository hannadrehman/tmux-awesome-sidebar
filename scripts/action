#!/bin/sh
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
PROJECT_ROOT=$(CDPATH= cd -- "$ROOT/.." && pwd -P); export PROJECT_ROOT
. "$ROOT/lib/common.sh"
. "$ROOT/lib/tree.sh"
. "$ROOT/lib/naming.sh"

usage() { echo "usage: action <action> ..." >&2; exit 2; }
context_window() { tas_validate_id "$1" pane || return 2; tas_tmux display-message -p -t "$1" '#{window_id}'; }
context_session() {
  tas_validate_id "$1" pane || return 2
  window=$(context_window "$1") || return 2
  tas_tmux list-windows -a -F '#{session_id}	#{session_name}	#{window_id}' |
    awk -F '\t' -v w="$window" '$3==w && $2 !~ /^__awesome_sidebar_/{print $1; exit}'
}
context_content_pane() { window=$(context_window "$1") || return 2; tas_tmux list-panes -t "$window" -F '#{pane_id} #{@awesome_sidebar_kind}' | awk '$2!="sidebar"{print $1;exit}'; }
context_group() {
  session=$1; window=$2; pane=$3
  tas_validate_id "$session" session && tas_validate_id "$window" window && tas_validate_id "$pane" pane || return 2
  [ "$(context_window "$pane")" = "$window" ] || return 1
  group=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_group)
  [ -n "$group" ] || return 1
  tas_validate_text "$group" || return 2
  printf '%s\n' "$group"
}
group_storage() {
  group=$1; context=${2-}
  if [ -n "$context" ]; then
    window=$(context_window "$context") || return 2
    storage=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_storage)
    [ -n "$storage" ] && { printf '%s\n' "$storage"; return 0; }
  fi
  tas_tmux list-sessions -F '#{session_name} #{@awesome_sidebar_group} #{@awesome_sidebar_storage}' | awk -v g="$group" '$2==g && $3!=""{print $1; exit}'
}
group_host() {
  group=$1; context=${2-}
  if [ -n "$context" ]; then
    window=$(context_window "$context") || return 2
    actual=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_group)
    [ "$actual" = "$group" ] || return 1
    host=$(context_session "$context")
    [ -n "$host" ] || host="\$${group#s}"
    case "$host" in *-w*) host=${host%%-w*};; esac
    printf '%s\n' "$host"
    return 0
  fi
  host=$(tas_tmux list-sessions -F '#{session_id} #{session_name} #{@awesome_sidebar_group}' | awk -v g="$group" '$3==g && $2 !~ /^__awesome_sidebar_/{print $1; exit}')
  [ -n "$host" ] || case "$group" in
    s[0-9]*-w[0-9]*) host="\$${group#s}"; host=${host%%-w*} ;;
  esac
  printf '%s\n' "$host"
}
window_has_link() { tas_tmux list-windows -t "$1" -F '#{window_id}' | awk -v w="$2" '$0==w{ok=1} END{exit !ok}'; }

enable_group() {
  session=$1; window=$2; pane=$3
  tas_validate_id "$session" session && tas_validate_id "$window" window && tas_validate_id "$pane" pane || return 2
  kind=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_kind}')
  [ "$kind" = sidebar ] && return 0
  group=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_group)
  [ -n "$group" ] || group=$(tas_tmux show-option -qv -t "$session" @awesome_sidebar_group)
  [ -n "$group" ] || group="s${session#\$}-w${window#@}"
  tas_validate_text "$group" || return 2
  session_group=$(tas_tmux show-option -qv -t "$session" @awesome_sidebar_group)
  storage=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_storage)
  [ -n "$storage" ] || { [ "$group" = "$session_group" ] && storage=$(tas_tmux show-option -qv -t "$session" @awesome_sidebar_storage); }
  [ -n "$storage" ] || storage="__awesome_sidebar_$group"
  width=$(tas_clamp_width "$(tas_tmux show-option -gqv @awesome_sidebar_width)")
  icons=$(tas_tmux show-option -gqv @awesome_sidebar_icons); [ "$icons" = nerd ] || icons=ascii
  tas_tmux set-option -t "$session" @awesome_sidebar_enabled on || return 1
  [ -n "$session_group" ] || tas_tmux set-option -t "$session" @awesome_sidebar_group "$group" || return 1
  [ -n "$(tas_tmux show-option -qv -t "$session" @awesome_sidebar_storage)" ] || tas_tmux set-option -t "$session" @awesome_sidebar_storage "$storage" || return 1
  tas_tmux set-option -t "$session" @awesome_sidebar_host_session "$session" || return 1
  tas_tmux set-option -w -t "$window" @awesome_sidebar_group "$group" || return 1
  tas_tmux set-option -w -t "$window" @awesome_sidebar_storage "$storage" || return 1
  tas_tmux set-option -w -t "$window" @awesome_sidebar_kind content || return 1
  tab=$(printf '\t')
  window_index=$(tas_tmux list-windows -t "$session" -F "#{window_id}${tab}#{window_index}" | awk -F '\t' -v w="$window" '$1==w{print $2;exit}')
  tas_tmux set-option -w -t "$window" @awesome_sidebar_host_index "$window_index" || return 1
  if ! tas_tmux has-session -t "$storage" 2>/dev/null; then
    tas_tmux new-session -d -s "$storage" -n bootstrap -c "$(tas_tmux display-message -p -t "$pane" '#{pane_current_path}')" || return 1
    tas_tmux set-option -t "$storage" @awesome_sidebar_group "$group" || return 1
    tas_tmux set-option -t "$storage" @awesome_sidebar_storage "$storage" || return 1
  fi
  window_has_link "$storage" "$window" || tas_tmux link-window -s "$window" -t "$storage:" || return 1
  bootstrap=$(tas_tmux list-windows -t "$storage" -F '#{window_id}	#{window_name}' | awk -F '\t' '$2=="bootstrap"{print $1; exit}')
  [ -z "$bootstrap" ] || [ "$bootstrap" = "$window" ] || tas_tmux kill-window -t "$bootstrap" || return 1
  if ! tas_tmux list-panes -t "$window" -F '#{@awesome_sidebar_kind}' | grep -Fqx sidebar; then
    sidebar=$(tas_tmux split-window -d -h -p "$width" -t "$window" -P -F '#{pane_id}') || return 1
    tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_kind sidebar || return 1
    tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_group "$group" || return 1
    tas_tmux set-option -p -t "$sidebar" @awesome_sidebar_cursor "" || return 1
    tas_tmux respawn-pane -k -t "$sidebar" "$ROOT/sidebar-view" "$group" "$sidebar" "$width" "$icons" || return 1
  fi
  tas_signal_group "$group"
}

session_new() {
  group=$1; path=$2; name=$3; context=${4-}
  tas_validate_text "$group" && tas_validate_text "$path" && tas_validate_text "$name" || return 2
  storage=$(group_storage "$group" "$context"); [ -n "$storage" ] || return 1
  [ -d "$path" ] || return 1
  win=$(tas_tmux new-window -d -t "$storage" -n "$name" -c "$path" -P -F '#{window_id}') || return 1
  tas_tmux set-option -w -t "$win" @awesome_sidebar_group "$group" || return 1
  tas_tmux set-option -w -t "$win" @awesome_sidebar_kind content || return 1
  tas_tmux set-option -w -t "$win" @awesome_sidebar_name "$name" || return 1
  tas_signal_group "$group"
  printf '%s\n' "$win"
}

disable_group() {
  session=$1; window=$2; pane=$3; group=$4
  tas_validate_id "$session" session && tas_validate_id "$window" window && tas_validate_id "$pane" pane || return 2
  storage=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_storage)
  [ -n "$storage" ] || return 1
  for win in $(tas_tmux list-windows -t "$storage" -F '#{window_id}'); do
    window_has_link "$session" "$win" || tas_tmux link-window -s "$win" -t "$session:" || return 1
  done
  for sidebar in $(tas_tmux list-panes -t "$window" -F '#{pane_id}'); do
    [ "$(tas_tmux display-message -p -t "$sidebar" '#{@awesome_sidebar_kind}')" = sidebar ] && tas_tmux kill-pane -t "$sidebar" || :
  done
  tas_tmux set-option -w -t "$window" @awesome_sidebar_enabled off || return 1
  tas_tmux kill-session -t "$storage" 2>/dev/null || :
}

disable_session() {
  session=$1; group=$2
  tas_validate_id "$session" session || return 2
  storage=$(tas_tmux show-option -qv -t "$session" @awesome_sidebar_storage)
  [ -n "$storage" ] || return 1
  for window in $(tas_tmux list-windows -t "$storage" -F '#{window_id}'); do
    window_has_link "$session" "$window" || tas_tmux link-window -s "$window" -t "$session:" || return 1
  done
  for window in $(tas_tmux list-windows -t "$session" -F '#{window_id}'); do
    for sidebar in $(tas_tmux list-panes -t "$window" -F '#{pane_id}'); do
      [ "$(tas_tmux display-message -p -t "$sidebar" '#{@awesome_sidebar_kind}')" = sidebar ] && tas_tmux kill-pane -t "$sidebar" || :
    done
  done
  tas_tmux set-option -t "$session" @awesome_sidebar_enabled off || return 1
  tas_tmux kill-session -t "$storage" 2>/dev/null || :
}

auto_enable() {
  for session in $(tas_tmux list-sessions -F '#{session_id}'); do
    name=$(tas_tmux display-message -p -t "$session" '#{session_name}')
    case "$name" in
      __awesome_sidebar_*) continue ;;
    esac
    for window in $(tas_tmux list-windows -t "$session" -F '#{window_id}'); do
      pane=$(tas_tmux list-panes -t "$window" -F '#{pane_id}' | sed -n '1p')
      [ -n "$pane" ] || continue
      group=$(tas_tmux show-option -wqv -t "$window" @awesome_sidebar_group)
      [ -n "$group" ] || group="s${session#\$}-w$(tas_tmux display-message -p -t "$window" '#{window_index}')"
      tas_tmux set-option -w -t "$window" @awesome_sidebar_group "$group" || return 1
      tas_with_group_lock "$group" enable_group "$session" "$window" "$pane" || return 1
    done
  done
}

navigate_action() {
  pane=$1; direction=$2
  tas_validate_id "$pane" pane || return 2
  group=$(tas_tmux display-message -p -t "$pane" '#{@awesome_sidebar_group}')
  [ -n "$group" ] || return 1
  case "$direction" in
    up|down|home|end|gg|G)
      cursor=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_cursor)
      next=$(tas_build_rows "$group" | tas_tree_visible "$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_collapsed)" | tas_cursor_move "$cursor" "$direction")
      [ -n "$next" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$next" || : ;;
    parent|child)
      cursor=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_cursor)
      [ -n "$cursor" ] || return 0
      if [ "$direction" = parent ]; then
        next=$(tas_build_rows "$group" | tas_parent_for_row "$cursor")
        [ -n "$next" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$next" || :
      else
        next=$(tas_build_rows "$group" | awk -F '\t' -v p="$cursor" '$3==p{print $2;exit}')
        [ -n "$next" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$next" || :
      fi ;;
    collapse|expand|h|l)
      case "$direction" in
        h) direction='collapse' ;;
        l) direction='expand' ;;
      esac
      cursor=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_cursor)
      row=$(tas_build_rows "$group" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}')
      [ -n "$row" ] || return 0
      kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
      collapsed=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_collapsed)
      has=$(printf '%s\n' "$collapsed" | awk -F ',' -v id="$cursor" '{for(i=1;i<=NF;i++)if($i==id)ok=1}END{print ok+0}')
      if [ "$direction" = collapse ]; then
        if [ "$kind" = session ] && [ "$has" -eq 0 ]; then
          collapsed=$(printf '%s' "$collapsed" | awk -v id="$cursor" 'BEGIN{if(length(id))print id}')
          tas_tmux set-option -p -t "$pane" @awesome_sidebar_collapsed "$collapsed"
        elif [ "$kind" != session ]; then
          next=$(tas_build_rows "$group" | tas_parent_for_row "$cursor")
          [ -n "$next" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$next" || :
        fi
      elif [ "$kind" = session ] && [ "$has" -eq 1 ]; then
        collapsed=$(printf '%s\n' "$collapsed" | awk -F ',' -v id="$cursor" '{out="";for(i=1;i<=NF;i++)if($i!=""&&$i!=id)out=out (out?",":"") $i}END{print out}')
        tas_tmux set-option -p -t "$pane" @awesome_sidebar_collapsed "$collapsed"
      elif [ "$kind" = session ]; then
        next=$(tas_build_rows "$group" | awk -F '\t' -v p="$cursor" '$3==p{print $2;exit}')
        [ -n "$next" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$next" || :
      fi ;;
    enter)
      cursor=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_cursor)
      row=$(tas_build_rows "$group" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}')
      [ -n "$row" ] || return 0
      kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
      if [ "$kind" = pane ]; then
        tas_tmux select-pane -t "$cursor"
      elif [ "$kind" = session ]; then
        session-select "$group" "$cursor" "$pane" "$(group_host "$group" "$pane")"
      elif [ "$kind" = worktree ]; then
        path=$(printf '%s\n' "$row" | awk -F '\t' '{print $7}')
        [ -n "$path" ] || return 1
        "$ROOT/discover-worktrees" --activate "$group" "$path" "$pane" "$(group_host "$group" "$pane")" || :
      fi ;;
    *) return 2;;
  esac
  tas_signal_group "$group"
}

action=${1-}; [ -n "$action" ] || usage
case $action in
  auto-enable) [ "$#" -eq 1 ] || usage; auto_enable;;
  enter) [ "$#" -eq 4 ] || usage; shift; tas_validate_id "$1" session && tas_validate_id "$2" window && tas_validate_id "$3" pane || exit 2; tas_tmux has-session -t "$1" 2>/dev/null || exit 0; group=$(tas_tmux show-option -qv -t "$1" @awesome_sidebar_group); [ -n "$group" ] || group="s${1#\$}-w${2#@}"; tas_with_group_lock "$group" enable_group "$@";;
  enable) [ "$#" -eq 4 ] || usage; shift; tas_with_group_lock "$1" enable_group "$@";;
  disable)
    if [ "$#" -eq 2 ]; then
      session=$2; tas_validate_id "$session" session || exit 2
      window=$(tas_tmux list-windows -t "$session" -F '#{window_id}' | sed -n '1p')
      pane=$(tas_tmux list-panes -t "$window" -F '#{pane_id}' | sed -n '1p')
      group=$(tas_tmux show-option -qv -t "$session" @awesome_sidebar_group)
      tas_with_group_lock "$group" disable_session "$session" "$group"
      exit $?
    elif [ "$#" -eq 4 ]; then
      session=$2; window=$3; pane=$4
      group=$(context_group "$session" "$window" "$pane") || exit $?
      session=$(group_host "$group" "$pane") || exit $?
    else
      usage
    fi
    tas_with_group_lock "$group" disable_group "$session" "$window" "$pane" "$group" || :
    ;;
  session-new) [ "$#" -ge 4 ] && [ "$#" -le 5 ] || usage; shift; tas_with_group_lock "$1" session_new "$@";;
  session-select) [ "$#" -ge 3 ] && [ "$#" -le 5 ] || usage; group=$2; win=$3; context=${4-}; host_session=${5-}; tas_validate_id "$win" window || exit 2; if [ -n "$host_session" ]; then tas_validate_id "$host_session" session || exit 2; host=$host_session; else host=$(group_host "$group" "$context"); fi; storage=$(group_storage "$group" "$context"); [ -n "$host" ] && [ -n "$storage" ] || exit 1; window_has_link "$storage" "$win" || exit 1; old=$(tas_tmux list-windows -t "$host" -F '#{window_id}	#{@awesome_sidebar_group}	#{@awesome_sidebar_kind}' | awk -F '\t' -v g="$group" '$2==g && $3=="content"{print $1;exit}'); window_has_link "$host" "$win" || tas_tmux link-window -s "$win" -t "$host:" || exit 1; host_index=$(tas_tmux list-windows -t "$host" -F '#{window_id}	#{window_index}' | awk -F '\t' -v w="$win" '$1==w{print $2;exit}'); [ -n "$host_index" ] || exit 1; tas_tmux select-window -t "$host:$host_index" || exit 1; if [ -n "$old" ] && [ "$old" != "$win" ]; then old_index=$(tas_tmux list-windows -t "$host" -F '#{window_id}	#{window_index}' | awk -F '\t' -v w="$old" '$1==w{print $2;exit}'); [ -z "$old_index" ] || tas_tmux unlink-window -t "$host:$old_index" 2>/dev/null || :; fi; exit 0;;
  session-delete) [ "$#" -eq 4 ] || usage; [ "$4" = confirmed-yes ] || exit 2; tas_validate_id "$3" window || exit 2; tas_tmux kill-window -t "$3";;
  split) [ "$#" -ge 3 ] && [ "$#" -le 5 ] || usage; case $3 in horizontal) flag=h;; vertical) flag=v;; *) exit 2;; esac; context=${5-}; host=$(group_host "$2" "$context"); [ -n "$host" ] || exit 1; target=$(context_content_pane "$context" 2>/dev/null || tas_tmux display-message -p -t "$host" '#{window_id}'); [ "$#" -eq 3 ] && tas_tmux split-window -"$flag" -t "$target" || { [ "$#" -ge 4 ] || exit 2; case $4 in *[!0-9]*|'') exit 2;; esac; [ "$4" -ge 1 ] && [ "$4" -le 99 ] || exit 2; tas_tmux split-window -"$flag" -p "$4" -t "$target"; };;
  pane-select) [ "$#" -eq 3 ] || usage; tas_validate_id "$3" pane || exit 2; tas_tmux select-pane -t "$3";;
  refresh)
    if [ "$#" -eq 2 ]; then
      tas_signal_group "$2"
    elif [ "$#" -eq 4 ]; then
      group=$(context_group "$2" "$3" "$4") || exit $?
      tas_signal_group "$group"
    else
      usage
    fi
    ;;
  refresh-from-hook) group=$(tas_tmux display-message -p '#{@awesome_sidebar_group}'); [ -n "$group" ] && tas_signal_group "$group" || :;;
  navigate) [ "$#" -eq 3 ] || usage; navigate_action "$2" "$3";;
  rename) [ "$#" -eq 3 ] || usage; tas_validate_id "$2" pane || exit 2; tas_set_manual_name "$2" "$3";;
  rename-clear) [ "$#" -eq 2 ] || usage; tas_validate_id "$2" pane || exit 2; tas_clear_manual_name "$2";;
  search-update) [ "$#" -ge 3 ] && [ "$#" -le 4 ] || usage; tas_validate_text "$3" || exit 2; context=${4-}; host=$(group_host "$2" "$context"); [ -n "$host" ] || exit 1; if [ -n "$context" ]; then pane=$context; old=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_query); [ -n "$old" ] || { tas_tmux set-option -p -t "$pane" @awesome_sidebar_pre_search_cursor "$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_cursor)"; tas_tmux set-option -p -t "$pane" @awesome_sidebar_pre_search_collapsed "$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_collapsed)"; }; tas_tmux set-option -p -t "$pane" @awesome_sidebar_query "$3"; else tas_tmux set-option -t "$host" @awesome_sidebar_query "$3"; fi; tas_signal_group "$2";;
  search-clear) [ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage; context=${3-}; host=$(group_host "$2" "$context"); [ -n "$host" ] || exit 1; if [ -n "$context" ]; then pane=$context; tas_tmux set-option -p -t "$pane" @awesome_sidebar_query ''; saved=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_pre_search_cursor); [ -n "$saved" ] && tas_tmux set-option -p -t "$pane" @awesome_sidebar_cursor "$saved"; saved=$(tas_tmux show-option -p -qv -t "$pane" @awesome_sidebar_pre_search_collapsed); tas_tmux set-option -p -t "$pane" @awesome_sidebar_collapsed "$saved"; tas_tmux set-option -pu -t "$pane" @awesome_sidebar_pre_search_cursor; tas_tmux set-option -pu -t "$pane" @awesome_sidebar_pre_search_collapsed; else tas_tmux set-option -t "$host" @awesome_sidebar_query ''; fi; tas_signal_group "$2";;
  search-activate) [ "$#" -ge 3 ] && [ "$#" -le 4 ] || usage; group=$2; target=$3; context=${4-}; tas_validate_text "$target" || exit 2; if tas_validate_id "$target" pane 2>/dev/null; then tas_tmux select-pane -t "$target"; elif tas_validate_id "$target" window 2>/dev/null; then session-select "$group" "$target" "$context"; elif [ "${target#worktree:}" != "$target" ]; then "$ROOT/discover-worktrees" --activate "$group" "${target#worktree:}"; else exit 2; fi;;
  *) usage;;
esac
