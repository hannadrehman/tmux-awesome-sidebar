BEGIN { FS="\t"; q=tolower(query); n=split(q,t,/ +/); count=0; }
function subseq(needle, hay,    i,j,c,gap,first,last) { needle=tolower(needle); hay=tolower(hay); j=1; gap=0; first=0; last=0; for(i=1;i<=length(hay)&&j<=length(needle);i++){c=substr(hay,i,1); if(c==substr(needle,j,1)){if(!first)first=i; last=i; j++} else if(first) gap++} if(j<=length(needle)) return -1; return (last-first+1)-length(needle); }
{ if(q==""){print; next} total=0; ok=1; for(k=1;k<=n;k++){if(t[k]=="")continue; best=-1; for(f=4;f<=9 && f<=NF;f++){g=subseq(t[k],$f); if(g>=0){w=(f==4?100:f<=6?60:f==7?40:f==8?30:10); v=w-g; if(index(tolower($f),tolower(t[k]))==1)v+=20; if(v>best)best=v}} if(best<0)ok=0; total+=best} if(ok){scores[++count]=total; row[count]=$0}}
END { for(i=1;i<=count;i++)for(j=i+1;j<=count;j++)if(scores[j]>scores[i]||(scores[j]==scores[i]&&row[j]<row[i])){x=scores[i];scores[i]=scores[j];scores[j]=x;x=row[i];row[i]=row[j];row[j]=x} for(i=1;i<=count;i++)print scores[i] "\t" row[i] }
