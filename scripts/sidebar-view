#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PROJECT_ROOT=$(CDPATH= cd -- "$ROOT/.." && pwd -P); export PROJECT_ROOT
. "$ROOT/lib/common.sh"
. "$ROOT/lib/tree.sh"

session=${1-}
pane_id=${2-}
width=$(tas_clamp_width "${3:-17}")
icons=${4:-ascii}
tas_validate_id "$session" session || { echo Windows; exit 0; }

old_stty=$(stty -g 2>/dev/null || :)
restore_terminal() {
  [ -z "$old_stty" ] || stty "$old_stty" 2>/dev/null || :
}
trap 'restore_terminal' EXIT
trap 'exit 0' HUP INT TERM
stty -echo -icanon min 1 time 0 2>/dev/null || :

read_byte() {
  LC_ALL=C dd bs=1 count=1 2>/dev/null | od -An -tu1 | awk '{print $1}'
}

# Hooks can emit several refresh bytes while windows are being created or the
# plugin is reloaded. Collapse a burst into one refresh without dropping the
# first real user key queued behind it.
drain_refresh_bytes() {
  # A zero decisecond timeout leaves BSD dd blocked on a tty after a zero-byte
  # read. Use a bounded 100ms read so this remains portable on macOS.
  stty min 0 time 1 2>/dev/null || :
  while :; do
    drained=$(read_byte)
    [ -n "${drained-}" ] || break
    [ "$drained" = 12 ] && continue
    pending_byte=$drained
    break
  done
  stty min 1 time 0 2>/dev/null || :
}

leave_sidebar() {
  window=$(tas_tmux display-message -p -t "$pane_id" '#{window_id}')
  target=$(tas_tmux list-panes -t "$window" -F '#{pane_id} #{@awesome_sidebar_kind}' |
    awk '$2!="sidebar"{print $1;exit}')
  [ -z "$target" ] || tas_tmux select-pane -t "$target"
}

prompt_reply() {
  prompt=$1
  restore_terminal
  printf '\033[2J\033[H%s' "$prompt"
  IFS= read -r reply || reply=''
  stty -echo -icanon min 1 time 0 2>/dev/null || :
}

add_worktree() {
  row=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}')
  [ "$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')" = session ] || return 0
  path=$(printf '%s\n' "$row" | awk -F '\t' '{print $7}')
  prompt_reply 'New worktree name (blank = automatic): '
  "$ROOT/action" worktree-add "$pane_id" "$path" "$reply" || :
  refresh_rows
  last=''
}

remove_row() {
  row=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}')
  [ -n "$row" ] || return 0
  kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
  path=$(printf '%s\n' "$row" | awk -F '\t' '{print $7}')
  label=$(printf '%s\n' "$row" | awk -F '\t' '{print $4}')
  case "$kind" in session|worktree) ;; *) return 0 ;; esac
  prompt_reply "Remove $label and close its tabs? [y/N]: "
  case "$reply" in y|Y|yes|YES) "$ROOT/action" remove-row "$pane_id" "$kind" "$path" || : ;; esac
  refresh_rows
  last=''
}

move_cursor() {
  direction=$1
  step=${2:-1}
  next=$(printf '%s\n' "$rows" | tas_cursor_move "$cursor" "$direction" "$step")
  [ -n "$next" ] || return 0
  tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_cursor "$next"
  cursor=$next
  printf '%s\n' "$rows" | tas_render "$width" "$icons" "$cursor" "$query"
  last=$cursor$(printf '\t')$collapsed$(printf '\t')$query$(printf '\n')$rows
}

sync_cursor() {
  next=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_cursor)
  [ -n "$next" ] || return 0
  printf '%s\n' "$rows" | awk -F '\t' -v id="$next" '$2==id{found=1}END{exit !found}' || return 0
  label_changed=0
  active_label=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_active_label)
  if [ -n "$active_label" ]; then
    parent=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$next" '$2==id{print $3;exit}')
    if [ -n "$parent" ]; then
      updated=$(printf '%s\n' "$rows" | awk -F '\t' -v OFS='\t' -v id="$parent" -v label="$active_label" '$2==id{$4=label}{print}')
      if [ "$updated" != "$rows" ]; then rows=$updated; label_changed=1; fi
    fi
  fi
  previous=$cursor
  cursor=$next
  if [ "$label_changed" -eq 1 ] || [ "$cursor" != "$previous" ]; then
    printf '%s\n' "$rows" | tas_render "$width" "$icons" "$cursor" "$query"
  fi
  last=$cursor$(printf '\t')$collapsed$(printf '\t')$query$(printf '\n')$rows
}

refresh_rows() {
  cursor=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_cursor)
  collapsed=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_collapsed)
  query=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_query)
  height=$(tas_tmux display-message -p -t "$pane_id" '#{pane_height}')
  case "$height" in *[!0-9]*|'') height=24 ;; esac
  page_size=$((height > 2 ? height - 2 : 1))
  half_page=$((page_size > 1 ? page_size / 2 : 1))
  rows=$(tas_build_rows "$session" | tas_tree_visible "$collapsed")
}

activate_cursor() {
  row=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}')
  [ -n "$row" ] || return 0
  kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
  target=$(printf '%s\n' "$row" | awk -F '\t' '{print $2}')
  path=$(printf '%s\n' "$row" | awk -F '\t' '{print $7}')
  hint=$(printf '%s\n' "$row" | awk -F '\t' '{print $11}')
  if [ "$kind" = worktree ]; then
    [ -n "$hint" ] || hint=$(printf '%s\n' "$rows" | awk -F '\t' -v p="$path" '$1=="worktree"&&$7==p&&$4~/ \*$/{print $3;exit}')
  fi
  "$ROOT/action" activate-row "$pane_id" "$kind" "$target" "$path" "$hint"
}

last=''
pending_byte=''
refresh_rows
drain_refresh_bytes
while :; do
  snapshot=$cursor$(printf '\t')$collapsed$(printf '\t')$query$(printf '\n')$rows
  if [ "$snapshot" != "$last" ]; then
    printf '%s\n' "$rows" | tas_render "$width" "$icons" "$cursor" "$query"
    last=$snapshot
  fi

  if [ -n "$pending_byte" ]; then
    byte=$pending_byte
    pending_byte=''
  else
    byte=$(read_byte)
  fi
  case ${byte-} in
    1)   sync_cursor ;;        # internal active-window sync
    106) move_cursor down ;;  # j
    107) move_cursor up ;;    # k
    103) move_cursor gg ;;    # g
    71)  move_cursor G ;;     # G
    97)  add_worktree ;;      # a
    114) remove_row ;;        # r
    21)  move_cursor page-up "$half_page" ;;    # Ctrl-u
    4)   move_cursor page-down "$half_page" ;;  # Ctrl-d
    2)   move_cursor page-up "$page_size" ;;    # Ctrl-b
    6)   move_cursor page-down "$page_size" ;;  # Ctrl-f
    10|13) activate_cursor ;;                            # Enter
    12)
      drain_refresh_bytes
      refresh_rows
      drain_refresh_bytes
      last=''
      ;;                                                # internal refresh
    113) leave_sidebar ;;                                # q
    27)
      stty min 0 time 1 2>/dev/null || :
      second=$(read_byte)
      if [ "${second-}" = 91 ]; then
        third=$(read_byte)
        case ${third-} in
          65) move_cursor up ;;
          66) move_cursor down ;;
        esac
      else
        leave_sidebar
      fi
      stty min 1 time 0 2>/dev/null || :
      ;;
  esac
done
