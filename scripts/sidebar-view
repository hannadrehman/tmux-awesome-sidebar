#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
. "$ROOT/lib/common.sh"
. "$ROOT/lib/tree.sh"
group=${1-}; pane_id=${2-}; width=$(tas_clamp_width "${3:-28}"); icons=${4:-ascii}
[ -n "$group" ] || { echo Sessions; exit 0; }
while :; do
  cursor=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_cursor)
  collapsed=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_collapsed)
  query=$(tas_tmux show-option -t "$pane_id" -qv @awesome_sidebar_query)
  tas_build_rows "$group" | tas_tree_visible "$collapsed" | tas_render "$width" "$icons" "$cursor" "$query"
  tas_tmux wait-for "awesome-sidebar-refresh-${pane_id#%}" || exit 0
done
