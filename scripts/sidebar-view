#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PROJECT_ROOT=$(CDPATH= cd -- "$ROOT/.." && pwd -P); export PROJECT_ROOT
. "$ROOT/lib/common.sh"
. "$ROOT/lib/tree.sh"

session=${1-}
pane_id=${2-}
width=$(tas_clamp_width "${3:-17}")
icons=${4:-ascii}
tas_validate_id "$session" session || { echo Windows; exit 0; }

old_stty=$(stty -g 2>/dev/null || :)
restore_terminal() {
  printf '\033[?1000l\033[?1006l' 2>/dev/null || :
  [ -z "$old_stty" ] || stty "$old_stty" 2>/dev/null || :
}
trap 'restore_terminal' EXIT
trap 'exit 0' HUP INT TERM
stty -echo -icanon min 1 time 0 2>/dev/null || :
printf '\033[?1000h\033[?1006h'

# Timed single-byte peek. The shell's read builtin ignores the stty VTIME
# timeout, so every bounded read has to go through dd.
peek_byte() {
  LC_ALL=C dd bs=1 count=1 2>/dev/null | od -An -tu1 | awk '{print $1}'
}

read_byte() {
  if [ "$TAS_FAST_READ" -eq 1 ]; then
    # bash builtins only: no fork per keystroke. A successful read with an
    # empty variable means the byte was a newline (read treats it as the
    # delimiter and does not assign it). Never fail: callers run under set -e.
    if IFS= read -r -n 1 tas_read_char; then
      if [ -n "$tas_read_char" ]; then
        printf '%d' "'$tas_read_char"
      else
        printf '10'
      fi
    fi
  else
    LC_ALL=C dd bs=1 count=1 2>/dev/null | od -An -tu1 | awk '{print $1}'
  fi
  return 0
}

# Probe once: read -N 1 is not POSIX but works on bash (macOS /bin/sh) and zsh.
TAS_FAST_READ=0
if [ "$(printf a | { IFS= read -r -n 1 tas_probe 2>/dev/null && printf '%s' "$tas_probe"; })" = a ]; then
  TAS_FAST_READ=1
fi

# Hooks can emit several refresh bytes while windows are being created or the
# plugin is reloaded. Collapse a burst into one refresh without dropping the
# first real user key queued behind it.
stash_byte() {
  pending_byte="${1-}${pending_byte:+ $pending_byte}"
}

drain_refresh_bytes() {
  # A zero decisecond timeout leaves BSD dd blocked on a tty after a zero-byte
  # read. Use a bounded 100ms read so this remains portable on macOS.
  stty min 0 time 1 2>/dev/null || :
  while :; do
    drained=$(peek_byte)
    [ -n "${drained-}" ] || break
    [ "$drained" = 12 ] && continue
    pending_byte=$drained
    break
  done
  stty min 1 time 0 2>/dev/null || :
}

leave_sidebar() {
  window=$(tas_tmux display-message -p -t "$pane_id" '#{window_id}')
  target=$(tas_tmux list-panes -t "$window" -F '#{pane_id} #{@awesome_sidebar_kind}' |
    awk '$2!="sidebar"{print $1;exit}')
  [ -z "$target" ] || tas_tmux select-pane -t "$target"
}

prompt_reply() {
  prompt=$1
  restore_terminal
  printf '\033[2J\033[H%s' "$prompt"
  IFS= read -r reply || reply=''
  stty -echo -icanon min 1 time 0 2>/dev/null || :
  printf '\033[?1000h\033[?1006h'
}

add_worktree() {
  row=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}')
  [ "$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')" = session ] || return 0
  path=$(printf '%s\n' "$row" | awk -F '\t' '{print $7}')
  prompt_reply 'Branch name (existing, or blank = automatic): '
  requested=$reply
  prompt_reply 'Base ref for a new branch (blank = current HEAD): '
  base_ref=$reply
  created=$("$ROOT/action" worktree-add "$pane_id" "$path" "$requested" "$base_ref" || :)
  if [ -n "$created" ]; then
    cursor=worktree:$created
    tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_cursor "$cursor"
  fi
  refresh_rows
  last=''
}

current_row() {
  printf '%s\n' "$rows" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}'
}

rename_row() {
  row=$(current_row); [ -n "$row" ] || return 0
  kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
  case "$kind" in session|worktree) ;; *) return 0;; esac
  target=$(printf '%s\n' "$row" | awk -F '\t' '{print $2}')
  path=$(printf '%s\n' "$row" | awk -F '\t' '{print $7}')
  prompt_reply 'Display name (blank = reset): '
  "$ROOT/action" rename-row "$pane_id" "$kind" "$target" "$path" "$reply" || :
  refresh_rows
  last=''
}

run_row_action() {
  verb=$1
  row=$(current_row); [ -n "$row" ] || return 0
  kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
  target=$(printf '%s\n' "$row" | awk -F '\t' '{print $2}')
  path=$(printf '%s\n' "$row" | awk -F '\t' '{print $7}')
  hint=$(printf '%s\n' "$row" | awk -F '\t' '{print $11}')
  [ -n "$path" ] || return 0
  "$ROOT/action" row-command "$pane_id" "$kind" "$target" "$path" "$verb" "$hint" || :
}

remove_row() {
  row=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}')
  [ -n "$row" ] || return 0
  kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
  path=$(printf '%s\n' "$row" | awk -F '\t' '{print $7}')
  label=$(printf '%s\n' "$row" | awk -F '\t' '{print $4}')
  case "$kind" in session|worktree) ;; *) return 0 ;; esac
  prompt_reply "Remove $label and close its tabs? [y/N]: "
  case "$reply" in y|Y|yes|YES) "$ROOT/action" remove-row "$pane_id" "$kind" "$path" || : ;; esac
  refresh_rows
  last=''
}

apply_filter() {
  display_rows=''
  rows=$(printf '%s\n' "$all_rows" | tas_tree_visible "$collapsed" | tas_filter_rows "$query")
  if ! printf '%s\n' "$rows" | awk -F '\t' -v id="$cursor" '$2==id{found=1}END{exit !found}'; then
    cursor=$(printf '%s\n' "$rows" | awk -F '\t' 'NF{print $2;exit}')
  fi
}

render_sidebar() {
  update_viewport
  printf '%s\n' "$display_rows" | tas_render "$width" "$icons" "$cursor" "$query" "$search_mode" '' "$collapsed"
  printf '\033[%s;1H\033[2K%s' "$height" "$viewport_footer"
  last=$cursor$(printf '\t')$collapsed$(printf '\t')$query$(printf '\t')$search_mode$(printf '\n')$rows
}

render_cursor_change() {
  previous=$1
  old_offset=$viewport_offset
  update_viewport
  if [ "$old_offset" -eq "$viewport_offset" ] && [ "$pane_columns" -ge 32 ] && [ $((8 + ${#query})) -le "$pane_columns" ] &&
    printf '%s\n' "$display_rows" | awk -F '\t' -v old="$previous" -v new="$cursor" '$2==old{a=1}$2==new{b=1}END{exit !(a&&b)}'; then
    printf '%s\n' "$display_rows" | tas_render "$width" "$icons" "$cursor" "$query" "$search_mode" "$previous" "$collapsed"
    last=$cursor$(printf '\t')$collapsed$(printf '\t')$query$(printf '\t')$search_mode$(printf '\n')$rows
  else
    render_sidebar
  fi
}

update_viewport() {
  stats=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$cursor" '$2==id{pos=NR} END{print NR+0, pos+0}')
  total_rows=${stats%% *}
  position=${stats#* }
  case "$position" in *[!0-9]*|'') position=1;; esac
  case "$viewport_offset" in *[!0-9]*|'') viewport_offset=0;; esac
  if [ "$position" -le "$viewport_offset" ]; then viewport_offset=$((position - 1)); fi
  if [ "$position" -gt $((viewport_offset + body_size)) ]; then viewport_offset=$((position - body_size)); fi
  maximum=$((total_rows > body_size ? total_rows - body_size : 0))
  [ "$viewport_offset" -le "$maximum" ] || viewport_offset=$maximum
  [ "$viewport_offset" -ge 0 ] || viewport_offset=0
  if [ "$viewport_offset" -eq "$old_offset" ] && [ -n "$display_rows" ]; then
    return 0
  fi
  display_rows=$(printf '%s\n' "$rows" | tas_slice_rows "$viewport_offset" "$body_size")
  first=$((total_rows > 0 ? viewport_offset + 1 : 0))
  last_visible=$((viewport_offset + body_size)); [ "$last_visible" -le "$total_rows" ] || last_visible=$total_rows
  viewport_footer="$first-$last_visible/$total_rows  ? help"
}

begin_search() {
  search_mode=1
  pre_search_cursor=$cursor
  render_sidebar
}

update_search() {
  query=$1
  apply_filter
  cursor=$(printf '%s\n' "$rows" | awk -F '\t' 'NF{print $2;exit}')
  render_sidebar
}

handle_search_byte() {
  search_byte=$1
  case "$search_byte" in
    10|13)
      search_mode=0
      tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_query "$query"
      tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_cursor "$cursor"
      render_sidebar
      ;;
    27)
      search_mode=0
      query=''
      cursor=$pre_search_cursor
      apply_filter
      tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_query ''
      tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_cursor "$cursor"
      render_sidebar
      ;;
    8|127) update_search "${query%?}" ;;
    21) update_search '' ;;
    *)
      if [ "$search_byte" -ge 32 ] 2>/dev/null && [ "$search_byte" -le 126 ] 2>/dev/null && [ "${#query}" -lt 100 ]; then
        character=$(awk -v n="$search_byte" 'BEGIN{printf "%c",n}')
        update_search "$query$character"
      fi
      ;;
  esac
}

fast_move() {
  dirbyte=$1
  case $dirbyte in 106|66) direction=down ;; *) direction=up ;; esac
  # Render the first move immediately, then absorb keys that arrive within a
  # short window (held j/k) and move once more for the whole burst. The
  # bounded peek only delays idle time, never the visible move.
  move_cursor "$direction" 1
  count=0
  stty min 0 time 1 2>/dev/null || return 0
  while :; do
    b=$(peek_byte)
    [ -n "${b-}" ] || break
    case "$b $direction" in
      '106 down'|'66 down'|'107 up'|'65 up') count=$((count + 1)) ;;
      *) stash_byte "$b"; break ;;
    esac
  done
  stty min 1 time 0 2>/dev/null || :
  [ "$count" -gt 0 ] && move_cursor "$direction" "$count"
  return 0
}

move_cursor() {
  direction=$1
  step=${2:-1}
  next=$(printf '%s\n' "$rows" | tas_cursor_move "$cursor" "$direction" "$step")
  [ -n "$next" ] || return 0
  previous=$cursor
  tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_cursor "$next"
  cursor=$next
  render_cursor_change "$previous"
}

set_collapsed() {
  collapsed=$1
  tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_collapsed "$collapsed"
  # Folding only changes which cached rows are visible; skip the full
  # tmux+git rebuild so h/l and za/zM/zR feel instant.
  apply_filter
  last=''
}

collapse_cursor() {
  row=$(current_row); [ -n "$row" ] || return 0
  kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
  if [ "$kind" = session ]; then
    case ",$collapsed," in *,$cursor,*) ;; *) set_collapsed "${collapsed:+$collapsed,}$cursor";; esac
  else
    parent=$(printf '%s\n' "$row" | awk -F '\t' '{print $3}')
    [ -n "$parent" ] || return 0
    previous=$cursor; cursor=$parent
    tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_cursor "$cursor"
    render_cursor_change "$previous"
  fi
}

expand_cursor() {
  row=$(current_row); [ -n "$row" ] || return 0
  kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
  [ "$kind" = session ] || return 0
  case ",$collapsed," in
    *,$cursor,*)
      updated=$(printf '%s\n' "$collapsed" | awk -F ',' -v id="$cursor" '{for(i=1;i<=NF;i++)if($i!=""&&$i!=id)out=out (out?",":"") $i}END{print out}')
      set_collapsed "$updated"
      ;;
    *)
      child=$(printf '%s\n' "$all_rows" | awk -F '\t' -v id="$cursor" '$3==id{print $2;exit}')
      [ -z "$child" ] || { previous=$cursor; cursor=$child; tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_cursor "$cursor"; render_cursor_change "$previous"; }
      ;;
  esac
}

toggle_cursor() {
  case ",$collapsed," in *,$cursor,*) expand_cursor;; *) collapse_cursor;; esac
}

collapse_all() {
  value=$(printf '%s\n' "$all_rows" | awk -F '\t' '$1=="session"{out=out (out?",":"") $2}END{print out}')
  set_collapsed "$value"
}

expand_all() { set_collapsed ''; }

render_help() {
  printf '\033[H\033[J%s\n' 'tmux awesome sidebar'
  printf '%s\n' \
    'j/k, arrows  move' 'gg/G         first/last' 'C-u/C-d      half page' 'C-b/C-f      full page' \
    'h/l          collapse/expand' 'za/zM/zR      toggle/all folds' '/             fuzzy search' 'Enter         open/focus' \
    'a             add worktree' 'r             remove' 'R             rename label' 'n/e/g         shell/editor/lazygit' \
    'y/o/p         copy/reveal/prune' '?             this help' 'q/Esc         content pane' '' 'Press any key to close help'
  read_byte >/dev/null || :
  render_sidebar
}

handle_z_command() {
  command_byte=$(read_byte)
  case ${command_byte-} in 97) toggle_cursor;; 77) collapse_all;; 82) expand_all;; esac
}

handle_g_command() {
  stty min 0 time 1 2>/dev/null || :
  second=$(peek_byte)
  stty min 1 time 0 2>/dev/null || :
  if [ "${second-}" = 103 ]; then move_cursor gg
  else
    run_row_action lazygit
    [ -z "${second-}" ] || stash_byte "$second"
  fi
}

handle_mouse() {
  payload=''
  terminator=''
  while :; do
    mouse_byte=$(read_byte); [ -n "${mouse_byte-}" ] || return 0
    case "$mouse_byte" in 77|109) terminator=$mouse_byte; break;; esac
    character=$(awk -v n="$mouse_byte" 'BEGIN{printf "%c",n}')
    payload=$payload$character
  done
  button=${payload%%;*}; remainder=${payload#*;}; column=${remainder%%;*}; mouse_row=${remainder#*;}
  case "$button" in
    64) move_cursor up; return 0;;
    65) move_cursor down; return 0;;
    0)
      case "$mouse_row" in *[!0-9]*|'') return 0;; esac
      [ "$terminator" = 77 ] || return 0
      [ "$mouse_row" -ge 2 ] && [ "$mouse_row" -lt "$height" ] || return 0
      clicked=$(printf '%s\n' "$display_rows" | awk -F '\t' -v n=$((mouse_row - 1)) 'NR==n{print $2;exit}')
      [ -n "$clicked" ] || return 0
      previous=$cursor; cursor=$clicked
      tas_tmux set-option -p -t "$pane_id" @awesome_sidebar_cursor "$cursor"
      render_cursor_change "$previous"
      activate_cursor
      ;;
  esac
}

sync_cursor() {
  next=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_cursor)
  [ -n "$next" ] || return 0
  printf '%s\n' "$rows" | awk -F '\t' -v id="$next" '$2==id{found=1}END{exit !found}' || return 0
  label_changed=0
  active_label=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_active_label)
  if [ -n "$active_label" ]; then
    parent=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$next" '$2==id{print $3;exit}')
    if [ -n "$parent" ]; then
      updated=$(printf '%s\n' "$rows" | awk -F '\t' -v OFS='\t' -v id="$parent" -v label="$active_label" '$2==id{$4=label}{print}')
      if [ "$updated" != "$rows" ]; then rows=$updated; label_changed=1; fi
    fi
  fi
  previous=$cursor
  cursor=$next
  if [ "$label_changed" -eq 1 ] || [ "$cursor" != "$previous" ]; then
    if [ "$label_changed" -eq 1 ]; then render_sidebar; else render_cursor_change "$previous"; fi
  fi
  last=$cursor$(printf '\t')$collapsed$(printf '\t')$query$(printf '\t')$search_mode$(printf '\n')$rows
}

refresh_rows() {
  display_rows=''
  collapsed=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_collapsed)
  height=$(tas_tmux display-message -p -t "$pane_id" '#{pane_height}')
  pane_columns=$(tas_tmux display-message -p -t "$pane_id" '#{pane_width}')
  case "$height" in *[!0-9]*|'') height=24 ;; esac
  case "$pane_columns" in *[!0-9]*|'') pane_columns=0 ;; esac
  body_size=$((height > 2 ? height - 2 : 1))
  page_size=$body_size
  half_page=$((page_size > 1 ? page_size / 2 : 1))
  # all_rows stays unfiltered: folding only changes which rows are visible,
  # and set_collapsed re-filters this cache. Filtering here would permanently
  # strip the children of collapsed sessions and break expanding.
  all_rows=$(tas_build_rows "$session")
  apply_filter
}

activate_cursor() {
  row=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$cursor" '$2==id{print;exit}')
  [ -n "$row" ] || return 0
  kind=$(printf '%s\n' "$row" | awk -F '\t' '{print $1}')
  target=$(printf '%s\n' "$row" | awk -F '\t' '{print $2}')
  path=$(printf '%s\n' "$row" | awk -F '\t' '{print $7}')
  hint=$(printf '%s\n' "$row" | awk -F '\t' '{print $11}')
  if [ "$kind" = worktree ]; then
    [ -n "$hint" ] || hint=$(printf '%s\n' "$rows" | awk -F '\t' -v p="$path" '$1=="worktree"&&$7==p&&$4~/ \*$/{print $3;exit}')
  fi
  "$ROOT/action" activate-row "$pane_id" "$kind" "$target" "$path" "$hint"
}

last=''
pending_byte=''
search_mode=0
pre_search_cursor=''
viewport_offset=0
old_offset=0
display_rows=''
cursor=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_cursor)
query=$(tas_tmux show-option -p -qv -t "$pane_id" @awesome_sidebar_query)
refresh_rows
drain_refresh_bytes
while :; do
  snapshot=$cursor$(printf '\t')$collapsed$(printf '\t')$query$(printf '\t')$search_mode$(printf '\n')$rows
  if [ "$snapshot" != "$last" ]; then
    render_sidebar
    last=$snapshot
  fi

  if [ -n "$pending_byte" ]; then
    byte=${pending_byte%%" "*}
    case $pending_byte in
      *" "*) pending_byte=${pending_byte#*" "} ;;
      *) pending_byte='' ;;
    esac
  else
    byte=$(read_byte)
  fi
  if [ "$search_mode" -eq 1 ]; then
    handle_search_byte "${byte-}"
    continue
  fi
  case ${byte-} in
    1)   sync_cursor ;;        # internal active-window sync
    106) fast_move 106 ;;    # j
    107) fast_move 107 ;;    # k
    103) handle_g_command ;;  # gg / lazygit
    71)  move_cursor G ;;     # G
    104) collapse_cursor ;;   # h
    108) expand_cursor ;;     # l
    122) handle_z_command ;;  # za / zM / zR
    97)  add_worktree ;;      # a
    114) remove_row ;;        # r
    82)  rename_row ;;        # R
    110) run_row_action shell ;;    # n
    101) run_row_action editor ;;   # e
    121) run_row_action copy ;;     # y
    111) run_row_action reveal ;;   # o
    112) run_row_action prune ;;    # p
    63)  render_help ;;       # ?
    47)  begin_search ;;      # /
    21)  move_cursor page-up "$half_page" ;;    # Ctrl-u
    4)   move_cursor page-down "$half_page" ;;  # Ctrl-d
    2)   move_cursor page-up "$page_size" ;;    # Ctrl-b
    6)   move_cursor page-down "$page_size" ;;  # Ctrl-f
    10|13) activate_cursor ;;                            # Enter
    12)
      drain_refresh_bytes
      refresh_rows
      sync_cursor
      drain_refresh_bytes
      last=''
      ;;                                                # internal refresh
    5)
      # Badge pickup: re-read the refreshed status cache without spawning
      # another refresh batch (see tas_emit_flush in lib/tree.sh).
      TAS_SKIP_BADGES=1
      export TAS_SKIP_BADGES
      drain_refresh_bytes
      refresh_rows
      sync_cursor
      drain_refresh_bytes
      last=''
      unset TAS_SKIP_BADGES
      ;;                                                # internal badge pickup
    113) leave_sidebar ;;                                # q
    27)
      stty min 0 time 1 2>/dev/null || :
      second=$(peek_byte)
      if [ "${second-}" = 91 ]; then
        third=$(read_byte)
        case ${third-} in
          65) fast_move 65 ;;
          66) fast_move 66 ;;
          60) handle_mouse ;;
        esac
      else
        [ -z "${second-}" ] || stash_byte "$second"
        leave_sidebar
      fi
      stty min 1 time 0 2>/dev/null || :
      ;;
  esac
done
